{
  "name": "New Upload Pipeline",
  "nodes": [
    {
      "parameters": {
        "path": "new-upload",
        "httpMethod": "POST",
        "responseMode": "lastNode"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "new-upload-trigger"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.body.evaluationResult != null}}",
              "value2": true
            },
            {
              "value1": "={{$json.body.evaluationResult.overallRiskScore != null}}",
              "value2": true
            },
            {
              "value1": "={{$json.body.evaluationResult.overallStatus != null}}",
              "value2": true
            }
          ]
        }
      },
      "name": "Validate Result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "subject": "Compliance Evaluation: {{$json.body.contractTitle}}",
        "text": "Contract: {{$json.body.contractTitle}}\n\nCompliance Evaluation: {{$json.body.evaluationResult.overallRiskScore}}/100\nStatus: {{$json.body.evaluationResult.overallStatus}}",
        "toEmail": "={{$json.body.recipients ? $json.body.recipients.join(\",\") : $json.body.uploaderEmail}}"
      },
      "name": "Notify Uploader",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        650,
        280
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Result": {
      "main": [
        [
          {
            "node": "Notify Uploader",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {}
}