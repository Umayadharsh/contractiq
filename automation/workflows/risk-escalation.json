{
  "name": "Risk Escalation",
  "nodes": [
    {
      "parameters": {
        "path": "risk-escalation",
        "httpMethod": "POST",
        "responseMode": "lastNode"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.body.riskSeverity == 'Critical'}}",
              "value2": true
            }
          ]
        }
      },
      "name": "Validate Critical",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "subject": "CRITICAL RISK ESCALATION: {{$json.body.contractTitle}}",
        "text": "Critical risk found in {{$json.body.contractTitle}} ({{$json.body.counterparty}}).\n\nReason: {{$json.body.riskReason}}\nRule: {{$json.body.citedRule}}\nClause: {{$json.body.citedClause}}",
        "toEmail": "={{$json.body.recipients ? $json.body.recipients.join(\",\") : \"admin@example.com\"}}"
      },
      "name": "Send Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [600, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate Critical",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Critical": {
      "main": [
        [
          {
            "node": "Send Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}