PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_SECRET=<shared-internal-secret>

# Passwords for the two standing accounts created by `npm run seed:accounts`.
# Real values belong in backend/.env (gitignored), never here and never in source.
SEED_ADMIN_PASSWORD=<admin-account-password>
SEED_REVIEWER_PASSWORD=<reviewer-account-password>

# Optional. Workspace that both standing accounts are enrolled into by the seed.
# Set this to the id of the workspace that already holds your shared documents
# (the first registered Admin's user id). Defaults to the earliest Admin.
# Without a membership in that workspace the accounts resolve to their own empty
# personal workspace and the contracts list appears empty.
# SEED_WORKSPACE_ID=<workspace-id>
